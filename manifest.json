{
  "manifest_version": 3,
  "name": "Pronde cê vai? — Captura de voo",
  "short_name": "Captura Pronde",
  "version": "1.1.0",
  "description": "Clique no voo escolhido no site da Smiles, LATAM Pass ou Azul e mande o print e os dados direto para o painel.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Capturar voo (Alt+Shift+C)",
    "default_icon": { "16": "icones/icone-16.png", "32": "icones/icone-32.png", "48": "icones/icone-48.png", "128": "icones/icone-128.png" }
  },
  "icons": { "16": "icones/icone-16.png", "48": "icones/icone-48.png", "128": "icones/icone-128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+C" }, "description": "Capturar voo" }
  },
  "content_scripts": [
    {
      "matches": ["https://*.github.io/*", "file:///*"],
      "js": ["ponte.js"],
      "run_at": "document_idle"
    }
  ]
}
